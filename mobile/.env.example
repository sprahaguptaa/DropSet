# Optional. The app already points at the team's Supabase project (see src/lib/supabase.ts).
# Copy to .env.local only to override, e.g. a personal test project.
# NEVER put the secret / service_role key or the DB password here.
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to 1 once the Google provider is enabled in Supabase (Authentication > Providers).
EXPO_PUBLIC_GOOGLE_AUTH=0
