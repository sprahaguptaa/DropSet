{
  "expo": {
    "name": "DropSet",
    "slug": "dropset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dropset",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F2EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dropset.app"
    },
    "android": {
      "package": "com.dropset.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "DropSet",
      "shortName": "DropSet",
      "themeColor": "#0B1020",
      "backgroundColor": "#F5F2EC"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DropSet uses your location to show gyms near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
